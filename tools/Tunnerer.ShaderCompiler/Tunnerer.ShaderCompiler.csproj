<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time shader compiler for the SDL_GPU backend. Tunnerer.Desktop runs it before every build that touches a
    shader. It compiles each HLSL file once per GPU API (DXIL for Direct3D 12, SPIR-V for Vulkan, MSL for Metal) with
    SDL_shadercross, on every OS, so a shader change that one API cannot take fails the build where it is made.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Native SDL3 and SDL_shadercross (with DXC and SPIRV-Cross) for every desktop OS. PrivateAssets keeps them out of
       projects that reference this tool only to get it built. -->
  <ItemGroup>
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.20" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.20" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.20" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.15" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.MacOS.Shadercross" Version="3.0.0.15" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.Linux.Shadercross" Version="3.0.0.15" PrivateAssets="all" />
  </ItemGroup>

</Project>
