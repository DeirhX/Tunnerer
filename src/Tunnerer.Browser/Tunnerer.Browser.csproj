<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>false</WasmEnableThreads>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The service worker versions the complete app. Stable URLs also work in module workers,
         which do not inherit the document's import map. -->
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tunnerer.Browser.Client/Tunnerer.Browser.Client.csproj" />
  </ItemGroup>
</Project>
